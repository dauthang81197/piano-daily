# ─────────────────────────────────────────────────────────────
# Piano Daily — biến môi trường (local).
# Sao chép thành `.env` ở gốc repo:  cp .env.example .env
# `docker compose` đọc file này để nội suy biến; API và Prisma cũng nạp nó khi chạy trên host.
# ─────────────────────────────────────────────────────────────

# ── Postgres (docker compose) ────────────────────────────────
POSTGRES_USER=piano
POSTGRES_PASSWORD=piano
POSTGRES_DB=piano_daily
# Cổng Postgres trên host. Đổi cổng này thì đổi cả cổng trong DATABASE_URL bên dưới cho khớp.
POSTGRES_PORT=5432

# ── API (apps/api) ───────────────────────────────────────────
# Bắt buộc. Trên host trỏ tới localhost; trong compose, service api tự dùng host `postgres`.
# Cổng phải khớp POSTGRES_PORT ở trên (mặc định 5432).
DATABASE_URL=postgresql://piano:piano@localhost:5432/piano_daily
# Tuỳ chọn (có mặc định):
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Test (apps/api integration) ──────────────────────────────
# Service `postgres-test` (profile `test`, tmpfs, cổng 5433).
# Nếu cổng 5433 trên máy đã bận: đổi POSTGRES_TEST_PORT và cổng trong TEST_DATABASE_URL cho khớp.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://piano:piano@localhost:5433/piano_daily_test

# ── Object storage S3 (SeaweedFS local; R2 ở production) ─────
# Chưa được API đọc ở Story 1.1 — module `media` dùng từ Story 1.6.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=piano
S3_SECRET_ACCESS_KEY=piano-secret
S3_BUCKET_PUBLIC=piano-daily-public
S3_BUCKET_PRIVATE=piano-daily-private

# ── Web / Admin (apps/web, apps/admin) ───────────────────────
# URL API mà trình duyệt gọi (admin, web client-side).
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL API mà server Next (SSR) gọi; trong compose là http://api:4000.
API_INTERNAL_URL=http://localhost:4000
