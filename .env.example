# ─────────────────────────────────────────────────────────────
# Piano Daily — biến môi trường (local).
# Sao chép thành `.env` ở gốc repo:  cp .env.example .env
# `docker compose` đọc file này để nội suy biến; API và Prisma cũng nạp nó khi chạy trên host.
# ─────────────────────────────────────────────────────────────

# ── Postgres (docker compose) ────────────────────────────────
POSTGRES_USER=piano
POSTGRES_PASSWORD=piano
POSTGRES_DB=piano_daily
# Cổng Postgres trên host. Đổi cổng này thì đổi cả cổng trong DATABASE_URL bên dưới cho khớp.
POSTGRES_PORT=5432

# ── API (apps/api) ───────────────────────────────────────────
# Bắt buộc. Trên host trỏ tới localhost; trong compose, service api tự dùng host `postgres`.
# Cổng phải khớp POSTGRES_PORT ở trên (mặc định 5432).
DATABASE_URL=postgresql://piano:piano@localhost:5432/piano_daily
# Tuỳ chọn (có mặc định):
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Xác thực admin (apps/api, module identity) ───────────────
# Bắt buộc, ≥ 32 ký tự; giá trị bắt đầu bằng `change-me` bị từ chối. Khoá ký access JWT (HS256, sống 15 phút). Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Tuỳ chọn: hạn refresh token (ngày, số nguyên 1–365). Cookie Max-Age khớp với hạn này.
REFRESH_TOKEN_TTL_DAYS=30
# Bắt buộc (URL http/https): origin của admin app — origin DUY NHẤT được CORS cho phép, kèm credentials
# (cookie refresh). Origin khác không nhận header Access-Control-Allow-*. Trong compose mặc định http://localhost:4101.
# Cookie refresh là `Secure; SameSite=Strict`: ngoài localhost, admin và API phải cùng site (cùng tên miền đăng ký,
# vd. admin.<domain> và api.<domain>) và chạy HTTPS — nếu không, tải lại trang admin sẽ mất phiên.
CORS_ADMIN_ORIGIN=http://localhost:4101
# Bắt buộc (URL http/https): origin của web công khai — được CORS cho phép nhưng KHÔNG kèm credentials.
CORS_WEB_ORIGIN=http://localhost:4100
# Bắt buộc, ≥ 32 ký tự, không bắt đầu bằng `change-me`: secret web SSR gửi qua header `X-Internal-Secret`
# để API bỏ qua throttle. Web và API phải dùng CÙNG giá trị; KHÔNG đặt tiền tố NEXT_PUBLIC_. Sinh bằng lệnh như JWT_ACCESS_SECRET.
INTERNAL_API_SECRET=dev-only-internal-api-secret-0123456789abcdef
# Bắt buộc, ≥ 32 ký tự, không bắt đầu bằng `change-me`: muối băm `visitor_hash = sha256(ip + ua + VIEW_SALT)` của bộ đếm
# lượt xem (không lưu IP/UA thô). Chỉ API đọc; KHÔNG đặt tiền tố NEXT_PUBLIC_. Sinh bằng lệnh như JWT_ACCESS_SECRET.
VIEW_SALT=dev-only-view-salt-0123456789abcdef0123456789
# SUPER_ADMIN do seed tạo: `pnpm --filter @piano-daily/api db:seed` (idempotent, không đổi mật khẩu nếu đã có).
ADMIN_EMAIL=admin@piano-daily.local
# ≥ 12 ký tự; giá trị bắt đầu bằng `change-me` bị từ chối.
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Founder

# ── Test (apps/api integration) ──────────────────────────────
# Service `postgres-test` (profile `test`, tmpfs, cổng 5433) và `seaweedfs` (bucket riêng
# piano-daily-test-public/private, tự tạo). Endpoint S3 của test: TEST_S3_ENDPOINT (mặc định http://localhost:8333).
# Nếu cổng 5433 trên máy đã bận: đổi POSTGRES_TEST_PORT và cổng trong TEST_DATABASE_URL cho khớp.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://piano:piano@localhost:5433/piano_daily_test

# ── Object storage S3 (module `media`; SeaweedFS local, R2 ở production) ─────
# Bắt buộc. Trên host trỏ tới localhost; trong compose, service api tự dùng http://seaweedfs:8333.
# Access key/secret phải khớp identity trong infra/seaweedfs/s3.json (SeaweedFS local).
S3_ENDPOINT=http://localhost:8333
# Tuỳ chọn (mặc định us-east-1; R2 dùng `auto`).
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=piano
S3_SECRET_ACCESS_KEY=piano-secret
# Bucket public: thumbnail, ảnh trang (đọc ẩn danh, cache immutable). Bucket private: file gốc PDF/MIDI/MP3.
# Hai bucket phải khác nhau. Local: s3.json chỉ cho đọc ẩn danh bucket public.
S3_BUCKET_PUBLIC=piano-daily-public
S3_BUCKET_PRIVATE=piano-daily-private
# URL gốc mà TRÌNH DUYỆT dùng để đọc bucket public (response API trả `<S3_PUBLIC_BASE_URL>/<key>`).
S3_PUBLIC_BASE_URL=http://localhost:8333/piano-daily-public
# Tuỳ chọn (true/false). Path-style (endpoint/bucket/key) — cần cho SeaweedFS; mặc định true.
S3_FORCE_PATH_STYLE=true
# Tuỳ chọn (true/false, mặc định false). true: API tạo bucket còn thiếu lúc khởi động — CHỈ dùng cho dev/test.
S3_AUTO_CREATE_BUCKETS=true

# ── PayPal (apps/api, module commerce — Story 3.3) ───────────
# sandbox (mặc định) hoặc live. Client id/secret của app REST PayPal tương ứng; thiếu thì tạo đơn trả 503
# (API vẫn khởi động). KHÔNG đặt tiền tố NEXT_PUBLIC_ cho secret.
PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Webhook ID của webhook PayPal trỏ tới POST /webhooks/paypal (sự kiện PAYMENT.CAPTURE.*; Story 3.8). Thiếu thì route trả 503.
# PAYPAL_WEBHOOK_ID=

# ── Email (apps/api, module notify — Story 3.7) ──────────────
# Resend (REST, không SDK). Tuỳ chọn: thiếu RESEND_API_KEY hoặc EMAIL_FROM thì API chỉ log cảnh báo và bỏ qua việc gửi email
# link tải (thanh toán vẫn bình thường). EMAIL_FROM phải thuộc domain đã xác minh trên Resend, vd. "Piano Daily <no-reply@piano-daily.example>".
# RESEND_API_KEY=
# EMAIL_FROM=
# URL công khai của web dùng dựng link tải trong email ({SITE_URL}/{locale}/downloads/{token}). Bỏ trống thì dùng CORS_WEB_ORIGIN.
# SITE_URL=http://localhost:4100

# ── Web / Admin (apps/web, apps/admin) ───────────────────────
# URL API mà trình duyệt gọi (admin, web client-side). Được inline lúc build: với Docker, compose truyền
# vào `build.args` của admin — đổi giá trị thì chạy lại `docker compose up -d --build admin`.
# Admin gọi API cross-origin kèm cookie: origin của admin phải khớp CORS_ADMIN_ORIGIN ở trên.
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL API mà server Next (SSR) gọi; trong compose là http://api:4000. Web gửi kèm X-Internal-Secret (INTERNAL_API_SECRET ở trên).
API_INTERNAL_URL=http://localhost:4000
# URL web mà API gọi `POST /api/revalidate` (kèm X-Internal-Secret) khi admin đổi nội dung; trong compose là http://web:4100.
# Tuỳ chọn: bỏ trống thì tắt revalidate chủ động (web vẫn tự làm mới sau tối đa 10 phút). Dùng chung INTERNAL_API_SECRET.
WEB_INTERNAL_URL=http://localhost:4100
# Origin media (bucket public) cho CSP `img-src` của web; inline lúc build (compose truyền qua build.args).
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8333/piano-daily-public
# PayPal client ID công khai cho nút thanh toán ở web (Story 3.6); dùng cùng app với PAYPAL_CLIENT_ID của API (sandbox khi
# PAYPAL_MODE=sandbox). KHÔNG bao giờ đặt client secret ở đây. Inline lúc build web; để trống thì modal báo chưa cấu hình.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Tuỳ chọn: email liên hệ hiển thị ở trang tải khi link tải hết hiệu lực (Story 3.5, mailto). Bỏ trống thì trang chỉ nhắc liên hệ
# qua email đã dùng khi mua. Inline lúc build web.
# NEXT_PUBLIC_CONTACT_EMAIL=
# Tuỳ chọn: URL gốc công khai của web (metadataBase cho canonical/hreflang ở web; admin dùng để mở trang xem trước Sheet
# Draft). Mặc định http://localhost:4100. Inline lúc build: đổi giá trị thì build lại web và admin.
# NEXT_PUBLIC_SITE_URL=http://localhost:4100
