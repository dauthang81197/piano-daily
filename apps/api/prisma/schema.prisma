// URL kết nối nằm trong prisma.config.ts (Prisma 7).
// Quy ước: model PascalCase, bảng/cột snake_case qua @map/@@map, PK UUIDv7 (uuidv7() của Postgres 18),
// thời gian timestamptz UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── identity ─────────────────────────────────────────────────

/// Phải trùng enum `Role` trong packages/shared (có test kiểm tra).
enum Role {
  SUPER_ADMIN
  EDITOR
}

model User {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Luôn lưu dạng chữ thường (login so khớp không phân biệt hoa thường).
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh token xoay vòng. Chỉ lưu sha256 của token; bản rõ chỉ nằm trong cookie của client.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── catalog ──────────────────────────────────────────────────
// Slug sinh từ tên lúc tạo (bỏ dấu, unique trong bảng, thêm hậu tố -2, -3… khi trùng) và không đổi khi đổi tên.

model Composer {
  id           String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  slug         String                   @unique
  bio          String?
  /// Ảnh đại diện; upload qua module `media` (Story 1.6).
  avatar       String?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cột generated (migration `catalog_search`): chỉ đọc bằng SQL thô trong repository tìm kiếm.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  series Series[]
  sheets Sheet[]

  @@index([searchVector], type: Gin)
  @@map("composers")
}

model Genre {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  /// Tên icon lucide thuộc `GENRE_ICONS` (packages/shared).
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheets SheetGenre[]

  @@map("genres")
}

model Series {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  slug       String   @unique
  composerId String   @map("composer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  composer Composer @relation(fields: [composerId], references: [id], onDelete: Restrict)
  sheets   Sheet[]

  @@index([composerId])
  @@map("series")
}

/// Phải trùng enum `Level` trong packages/shared (có test kiểm tra).
enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// Phải trùng enum `SheetStatus` trong packages/shared (có test kiểm tra).
enum SheetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Bài nhạc của thư viện. `has_*` và `page_count` chỉ được ghi bởi `recomputeDerived()` (catalog).
/// Slug sinh từ tiêu đề; sinh lại khi đổi tiêu đề cho tới lần publish đầu tiên, sau đó đóng băng (AD-16).
model Sheet {
  id               String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicId         Int                      @unique @default(autoincrement()) @map("public_id")
  slug             String                   @unique
  title            String
  subtitle         String?
  composerId       String                   @map("composer_id") @db.Uuid
  seriesId         String?                  @map("series_id") @db.Uuid
  level            Level
  /// 0–100 (CHECK trong migration).
  difficultyScore  Int?                     @map("difficulty_score") @db.SmallInt
  difficultyNote   String?                  @map("difficulty_note")
  description      String?
  /// Markdown.
  lyricsChords     String?                  @map("lyrics_chords")
  /// Dạng chuẩn `https://www.youtube.com/watch?v=ID`.
  youtubeUrl       String?                  @map("youtube_url")
  hasSheet         Boolean                  @default(false) @map("has_sheet")
  hasChords        Boolean                  @default(false) @map("has_chords")
  hasMidi          Boolean                  @default(false) @map("has_midi")
  hasMp3           Boolean                  @default(false) @map("has_mp3")
  hasVideo         Boolean                  @default(false) @map("has_video")
  pageCount        Int                      @default(0) @map("page_count")
  viewCount        Int                      @default(0) @map("view_count")
  isHot            Boolean                  @default(false) @map("is_hot")
  /// Miễn phí: bỏ qua giá riêng lẻ (vẫn giữ giá đã nhập). Giá là cents USD, null/0 = không bán.
  isFree           Boolean                  @default(false) @map("is_free")
  pricePdfCents    Int?                     @map("price_pdf_cents")
  priceMidiCents   Int?                     @map("price_midi_cents")
  priceMp3Cents    Int?                     @map("price_mp3_cents")
  priceBundleCents Int?                     @map("price_bundle_cents")
  status           SheetStatus              @default(DRAFT)
  firstPublishedAt DateTime?                @map("first_published_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cột generated (migration `catalog_search`): chỉ đọc bằng SQL thô trong repository tìm kiếm.
  searchVector     Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  composer  Composer          @relation(fields: [composerId], references: [id], onDelete: Restrict)
  series    Series?           @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  genres    SheetGenre[]
  files     SheetFile[]
  views     SheetViewDedupe[]
  downloads DownloadLog[]
  orders    Order[]

  @@index([status])
  @@index([composerId])
  @@index([seriesId])
  @@index([level])
  @@index([searchVector], type: Gin)
  @@map("sheets")
}

/// Genre của Sheet. Xoá Sheet thì xoá theo (CASCADE); Genre đang được gắn thì không xoá được (RESTRICT).
model SheetGenre {
  sheetId String @map("sheet_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([sheetId, genreId])
  @@index([genreId])
  @@map("sheet_genres")
}

/// Phải trùng enum `FileType` trong packages/shared (có test kiểm tra).
enum FileType {
  PDF
  MIDI
  MP3
  /// Note-JSON dẫn xuất công khai của MIDI (Story 1.7), đối xứng với THUMBNAIL/PAGE_IMAGE của PDF.
  MIDI_JSON
  THUMBNAIL
  PAGE_IMAGE
}

/// File của Sheet. Object nằm trên S3 (module `media`); bảng chỉ lưu key — không bao giờ trả key ra API.
/// Mỗi `(sheet_id, type)` của PDF/MIDI/MP3/MIDI_JSON chỉ có một bản hiện hành (`superseded_at IS NULL`):
/// partial unique index viết tay trong migration. THUMBNAIL/PAGE_IMAGE/MIDI_JSON trỏ tới PDF/MIDI sinh ra
/// chúng qua `source_file_id`.
model SheetFile {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sheetId         String    @map("sheet_id") @db.Uuid
  type            FileType
  storageKey      String    @map("storage_key")
  originalName    String?   @map("original_name")
  /// Bytes.
  size            Int
  mimeType        String    @map("mime_type")
  pageNumber      Int?      @map("page_number")
  /// Chỉ ghi cho dòng MIDI (giây, từ `Midi.duration`); null cho type khác.
  durationSeconds Float?    @map("duration_seconds") @db.DoublePrecision
  /// Chỉ ghi cho dòng MIDI (tổng `track.notes.length` mọi track); null cho type khác.
  noteCount       Int?      @map("note_count")
  sourceFileId    String?   @map("source_file_id") @db.Uuid
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet        Sheet               @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sourceFile   SheetFile?          @relation("SheetFileSource", fields: [sourceFileId], references: [id], onDelete: Cascade)
  derivedFiles SheetFile[]         @relation("SheetFileSource")
  tokenFiles   DownloadTokenFile[]

  @@index([sheetId])
  @@index([sourceFileId])
  @@map("sheet_files")
}

/// Dedupe lượt xem (AD-11, Story 2.7): mỗi `(sheet, visitor_hash, giờ UTC)` được đếm đúng một lần.
/// `visitor_hash` = sha256(ip + ua + VIEW_SALT) hex 64 ký tự; không lưu IP/UA thô. Chỉ ghi bằng SQL thô trong
/// repository `catalog` (cùng câu lệnh tăng `view_count`); job dọn xoá dòng cũ hơn 24 giờ.
model SheetViewDedupe {
  sheetId     String   @map("sheet_id") @db.Uuid
  visitorHash String   @map("visitor_hash") @db.Char(64)
  hourBucket  DateTime @map("hour_bucket") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@id([sheetId, visitorHash, hourBucket])
  @@index([hourBucket])
  @@map("sheet_view_dedupe")
}

/// Nhật ký mọi lượt tải thành công, miễn phí lẫn trả phí (AD-20, Story 3.2). Chỉ module `commerce` ghi.
/// `ip_hash` = sha256(ip + VIEW_SALT) hex; không lưu IP thô. `token_id` null cho tải miễn phí (token ở Story 3.4).
model DownloadLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sheetId   String   @map("sheet_id") @db.Uuid
  fileType  FileType @map("file_type")
  tokenId   String?  @map("token_id") @db.Uuid
  ipHash    String   @map("ip_hash") @db.Char(64)
  ua        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet Sheet          @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  token DownloadToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([sheetId, createdAt])
  @@map("download_logs")
}

/// Phải trùng enum `OrderStatus` trong packages/shared (có test kiểm tra).
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// Đơn hàng (Story 3.3, AD-20). Chỉ module `commerce` ghi; `status` chỉ đổi qua `OrderService` theo máy trạng thái ở shared.
/// `sheet_id` FK RESTRICT: Sheet từng có đơn không bị xoá cứng (archive). `items` là snapshot các type đã resolve kèm giá
/// (`[{fileType, priceCents}]`, bundle được tách từng type). `amount_cents` là cents USD nguyên.
model Order {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Dạng `PD-XXXXXX` (base32).
  orderCode       String      @unique @map("order_code")
  sheetId         String      @map("sheet_id") @db.Uuid
  /// Chữ thường; không bao giờ ghi vào log.
  email           String
  items           Json
  amountCents     Int         @map("amount_cents")
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  paypalOrderId   String?     @unique @map("paypal_order_id")
  paypalCaptureId String?     @map("paypal_capture_id")
  payerEmail      String?     @map("payer_email")
  payerName       String?     @map("payer_name")
  paidAt          DateTime?   @map("paid_at") @db.Timestamptz(6)
  refundedAt      DateTime?   @map("refunded_at") @db.Timestamptz(6)
  reviewRequired  Boolean     @default(false) @map("review_required")
  /// `vi` | `en` (CHECK ở migration): ngôn ngữ email link tải (Story 3.7).
  locale          String?     @default("vi")
  emailSentAt     DateTime?   @map("email_sent_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet          @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  token DownloadToken?

  @@index([sheetId])
  @@map("orders")
}

/// Quyền tải của một Order đã PAID (Story 3.4, AD-20): đúng một token cho mỗi Order (`order_id` UNIQUE).
/// Chỉ module `commerce` ghi. `token` là chuỗi ngẫu nhiên mật mã học; không bao giờ ghi vào log.
model DownloadToken {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String    @unique @map("order_id") @db.Uuid
  token         String    @unique
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  maxDownloads  Int       @map("max_downloads")
  usedDownloads Int       @default(0) @map("used_downloads")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  files        DownloadTokenFile[]
  downloadLogs DownloadLog[]

  @@map("download_tokens")
}

/// Danh sách `sheet_files` hiện hành tại lúc cấp token. FK RESTRICT: GC không xoá file còn được token tham chiếu.
model DownloadTokenFile {
  tokenId     String @map("token_id") @db.Uuid
  sheetFileId String @map("sheet_file_id") @db.Uuid

  token DownloadToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  file  SheetFile     @relation(fields: [sheetFileId], references: [id], onDelete: Restrict)

  @@id([tokenId, sheetFileId])
  @@index([sheetFileId])
  @@map("download_token_files")
}

/// Cấu hình key-value của site (Story 3.3). Chỉ module `settings` đọc/ghi. Khoá seed trong migration:
/// `payments_enabled`, `token_default_days`, `token_default_max_downloads`.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

/// Sự kiện webhook PayPal đã xác thực chữ ký (Story 3.8). `provider_event_id` UNIQUE chặn xử lý trùng.
/// Chỉ module `commerce` ghi. `processed_at` null = chưa xử lý xong (PayPal gửi lại sẽ xử lý lại). Không log payload.
model PaymentEvent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerEventId String    @unique @map("provider_event_id")
  type            String
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payment_events")
}

/// Phải trùng enum `AdPosition` trong packages/shared (có test kiểm tra).
enum AdPosition {
  HEADER
  SIDEBAR_LEFT
  SIDEBAR_RIGHT
  IN_LIST
  STICKY_BOTTOM
  IN_CONTENT
}

/// Vị trí quảng cáo (Story 4.5). Chỉ module `ads` ghi. `position` UNIQUE: mỗi vị trí tối đa một slot.
/// CHECK (migration): có `html_code` HOẶC (`image` VÀ `link`). `html_code` không bao giờ vào log.
model AdSlot {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  position  AdPosition @unique
  htmlCode  String?    @map("html_code")
  image     String?
  link      String?
  isActive  Boolean    @default(false) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ad_slots")
}
