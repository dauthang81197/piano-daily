// URL kết nối nằm trong prisma.config.ts (Prisma 7).
// Quy ước: model PascalCase, bảng/cột snake_case qua @map/@@map, PK UUIDv7 (uuidv7() của Postgres 18),
// thời gian timestamptz UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── identity ─────────────────────────────────────────────────

/// Phải trùng enum `Role` trong packages/shared (có test kiểm tra).
enum Role {
  SUPER_ADMIN
  EDITOR
}

model User {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Luôn lưu dạng chữ thường (login so khớp không phân biệt hoa thường).
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh token xoay vòng. Chỉ lưu sha256 của token; bản rõ chỉ nằm trong cookie của client.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── customers ────────────────────────────────────────────────
// Khách của web công khai, tách hẳn khỏi `User` (admin). Chỉ module `customers` ghi.

model Customer {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Luôn lưu dạng chữ thường; không bao giờ ghi vào log.
  email              String    @unique
  /// Null với tài khoản chỉ đăng nhập bằng Google.
  passwordHash       String?   @map("password_hash")
  /// `sub` của tài khoản Google đã liên kết.
  googleSub          String?   @unique @map("google_sub")
  name               String
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// `vi` | `en`: ngôn ngữ email gửi cho khách.
  locale             String    @default("vi")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Số lượt tải đã dùng trong dùng thử (S2 thuê bao). Hạn dùng thử = `email_verified_at` + `trial_days`.
  trialDownloadsUsed Int       @default(0) @map("trial_downloads_used")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
  refreshTokens        CustomerRefreshToken[]
  tokens               CustomerToken[]
  downloadLogs         DownloadLog[]
  courseProgress       CourseLessonProgress[]
  courseSubmissions    CourseSubmission[]
  courseRatings        CourseRating[]
  courseComments       CourseComment[]

  @@map("customers")
}

/// Refresh token xoay vòng của khách. Chỉ lưu sha256; bản rõ chỉ nằm trong cookie `customer_refresh`.
model CustomerRefreshToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

enum CustomerTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Token một lần trong link email (xác minh email 24 giờ, đặt lại mật khẩu 1 giờ). Chỉ lưu sha256.
model CustomerToken {
  id         String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  purpose    CustomerTokenPurpose
  tokenHash  String               @unique @map("token_hash")
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?            @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@map("customer_tokens")
}

// ── subscriptions ────────────────────────────────────────────
// Gói thuê bao (S2). Chỉ module `billing` ghi `plans` và `subscriptions`.

/// Gói do admin cấu hình. `download_quota` null = không giới hạn lượt tải mỗi kỳ. Giá VND nguyên, USD tính bằng cent.
model Plan {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nameVi        String   @map("name_vi")
  nameEn        String   @map("name_en")
  descriptionVi String   @default("") @map("description_vi")
  descriptionEn String   @default("") @map("description_en")
  priceVnd      Int      @map("price_vnd")
  priceUsdCents Int      @map("price_usd_cents")
  durationDays  Int      @map("duration_days")
  downloadQuota Int?     @map("download_quota")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

/// Phải trùng enum `SubscriptionStatus` trong packages/shared (có test kiểm tra).
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Gói của một khách. Hết hạn tính lười theo `current_period_end` (không cần cron). Mỗi khách tối đa một dòng ACTIVE
/// (unique một phần ở migration). `provider`: ADMIN (cấp tay), VIETQR/PAYPAL (S3/S4).
model Subscription {
  id                    String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd      DateTime           @map("current_period_end") @db.Timestamptz(6)
  downloadsUsedInPeriod Int                @default(0) @map("downloads_used_in_period")
  /// Hạn mức tải của kỳ, chụp lúc kích hoạt/cấp (sửa `plans.download_quota` sau đó không ảnh hưởng). null = không giới hạn.
  downloadQuota         Int?               @map("download_quota")
  provider              String?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([customerId, status])
  @@index([planId])
  @@map("subscriptions")
}

/// Phải trùng enum `SubscriptionPaymentStatus` trong packages/shared (có test kiểm tra).
enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// Thanh toán gói (S3 PayPal, S4 VietQR). Chỉ module `billing` ghi. `amount` là đơn vị nhỏ nhất của `currency`
/// (USD cents / VND). `terms` chụp điều khoản gói lúc mua. `provider_ref`: PayPal order id hoặc mã đối soát VietQR.
model SubscriptionPayment {
  id              String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Dạng `PS-XXXXXX` (base32); cũng là `custom_id` của đơn PayPal.
  code            String                    @unique
  customerId      String                    @map("customer_id") @db.Uuid
  planId          String                    @map("plan_id") @db.Uuid
  provider        String
  status          SubscriptionPaymentStatus @default(PENDING)
  amount          Int
  currency        String
  terms           Json
  providerRef     String?                   @unique @map("provider_ref")
  paypalCaptureId String?                   @map("paypal_capture_id")
  payerEmail      String?                   @map("payer_email")
  reviewRequired  Boolean                   @default(false) @map("review_required")
  subscriptionId  String?                   @map("subscription_id") @db.Uuid
  paidAt          DateTime?                 @map("paid_at") @db.Timestamptz(6)
  refundedAt      DateTime?                 @map("refunded_at") @db.Timestamptz(6)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_payments")
}

// ── courses ──────────────────────────────────────────────────
// Khoá học (C1): Nhánh -> Level -> Section -> Bài học. Chỉ module `courses` ghi. `sort_order` số nguyên trong cùng cha;
// một bài chỉ công khai khi chính nó và cả ba cấp cha `is_published`. Bài học có nhạc riêng (upload MIDI), không qua Sheet.

model CourseTrack {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String   @unique
  title         String
  titleEn       String?  @map("title_en")
  description   String   @default("")
  descriptionEn String?  @map("description_en")
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  levels CourseLevel[]

  @@index([sortOrder])
  @@map("course_tracks")
}

model CourseLevel {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  trackId       String   @map("track_id") @db.Uuid
  /// Mức chọn từ danh sách (BEGINNER|INTERMEDIATE|ADVANCED|EXPERT); null = "Khác" (tự đặt tên).
  preset        String?
  title         String
  titleEn       String?  @map("title_en")
  description   String   @default("")
  descriptionEn String?  @map("description_en")
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  track    CourseTrack     @relation(fields: [trackId], references: [id], onDelete: Restrict)
  sections CourseSection[]

  @@index([trackId, sortOrder])
  @@map("course_levels")
}

model CourseSection {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  levelId       String   @map("level_id") @db.Uuid
  title         String
  titleEn       String?  @map("title_en")
  description   String   @default("")
  descriptionEn String?  @map("description_en")
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  level   CourseLevel    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  lessons CourseLesson[]

  @@index([levelId, sortOrder])
  @@map("course_sections")
}

model CourseLesson {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sectionId           String   @map("section_id") @db.Uuid
  title               String
  titleEn             String?  @map("title_en")
  youtubeUrl          String?  @map("youtube_url")
  content             String   @default("")
  contentEn           String?  @map("content_en")
  durationMinutes     Int?     @map("duration_minutes")
  /// Nhạc của bài (upload MIDI): file gốc ở vùng private, note-JSON ở vùng public. Cùng null hoặc cùng có.
  midiStorageKey      String?  @map("midi_storage_key")
  noteJsonKey         String?  @map("note_json_key")
  midiOriginalName    String?  @map("midi_original_name")
  midiDurationSeconds Float?   @map("midi_duration_seconds")
  midiNoteCount       Int?     @map("midi_note_count")
  sortOrder           Int      @default(0) @map("sort_order")
  isPublished         Boolean  @default(false) @map("is_published")
  /// Xem thử miễn phí (C5): khi cưỡng chế thuê bao BẬT, bài không xem thử chỉ dành cho khách có gói.
  isFreePreview       Boolean  @default(false) @map("is_free_preview")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  section     CourseSection          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  progress    CourseLessonProgress[]
  submissions CourseSubmission[]
  ratings     CourseRating[]
  comments    CourseComment[]

  @@index([sectionId, sortOrder])
  @@map("course_lessons")
}

/// Bài đã hoàn thành của khách (C2). Có dòng = đã học; bỏ đánh dấu = xoá dòng.
model CourseLessonProgress {
  customerId  String   @map("customer_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([customerId, lessonId])
  @@index([lessonId])
  @@map("course_lesson_progress")
}

/// Bài nộp của khách (C3): link YouTube/Drive đã chuẩn hoá. Tối đa một dòng mỗi (khách, bài); admin ẩn bằng `is_hidden`.
model CourseSubmission {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  /// `YOUTUBE` | `DRIVE` (CHECK ở DB).
  kind       String
  url        String
  note       String?
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([customerId, lessonId])
  @@index([lessonId, createdAt(sort: Desc)])
  @@map("course_submissions")
}

/// Đánh giá sao của khách cho bài học (C4): một dòng mỗi (khách, bài); `stars` 1..5 (CHECK ở DB).
model CourseRating {
  customerId String   @map("customer_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  stars      Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([customerId, lessonId])
  @@index([lessonId])
  @@map("course_ratings")
}

/// Bình luận bài học (C4): văn bản thuần ≤ 1000 ký tự, trả lời một cấp (`parent_id` trỏ bình luận gốc), kiểm duyệt sau bằng `is_hidden`.
model CourseComment {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lessonId   String    @map("lesson_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  body       String
  isHidden   Boolean   @default(false) @map("is_hidden")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  editedAt   DateTime? @map("edited_at") @db.Timestamptz(6)

  lesson   CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parent   CourseComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CourseComment[] @relation("CommentReplies")

  @@index([lessonId, parentId, createdAt(sort: Desc)])
  @@index([parentId])
  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@map("course_comments")
}

// ── catalog ──────────────────────────────────────────────────
// Slug sinh từ tên lúc tạo (bỏ dấu, unique trong bảng, thêm hậu tố -2, -3… khi trùng) và không đổi khi đổi tên.

model Composer {
  id           String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  slug         String                   @unique
  bio          String?
  /// Ảnh đại diện; upload qua module `media` (Story 1.6).
  avatar       String?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cột generated (migration `catalog_search`): chỉ đọc bằng SQL thô trong repository tìm kiếm.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  series Series[]
  sheets Sheet[]

  @@index([searchVector], type: Gin)
  @@map("composers")
}

model Genre {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  /// Tên icon lucide thuộc `GENRE_ICONS` (packages/shared).
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheets SheetGenre[]

  @@map("genres")
}

model Series {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  slug       String   @unique
  composerId String   @map("composer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  composer Composer @relation(fields: [composerId], references: [id], onDelete: Restrict)
  sheets   Sheet[]

  @@index([composerId])
  @@map("series")
}

/// Phải trùng enum `Level` trong packages/shared (có test kiểm tra).
enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// Phải trùng enum `SheetStatus` trong packages/shared (có test kiểm tra).
enum SheetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Bài nhạc của thư viện. `has_*` và `page_count` chỉ được ghi bởi `recomputeDerived()` (catalog).
/// Slug sinh từ tiêu đề; sinh lại khi đổi tiêu đề cho tới lần publish đầu tiên, sau đó đóng băng (AD-16).
model Sheet {
  id               String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicId         Int                      @unique @default(autoincrement()) @map("public_id")
  slug             String                   @unique
  title            String
  subtitle         String?
  composerId       String                   @map("composer_id") @db.Uuid
  seriesId         String?                  @map("series_id") @db.Uuid
  level            Level
  /// 0–100 (CHECK trong migration).
  difficultyScore  Int?                     @map("difficulty_score") @db.SmallInt
  difficultyNote   String?                  @map("difficulty_note")
  description      String?
  /// Markdown.
  lyricsChords     String?                  @map("lyrics_chords")
  /// Dạng chuẩn `https://www.youtube.com/watch?v=ID`.
  youtubeUrl       String?                  @map("youtube_url")
  hasSheet         Boolean                  @default(false) @map("has_sheet")
  hasChords        Boolean                  @default(false) @map("has_chords")
  hasMidi          Boolean                  @default(false) @map("has_midi")
  hasMp3           Boolean                  @default(false) @map("has_mp3")
  hasVideo         Boolean                  @default(false) @map("has_video")
  pageCount        Int                      @default(0) @map("page_count")
  viewCount        Int                      @default(0) @map("view_count")
  isHot            Boolean                  @default(false) @map("is_hot")
  /// Miễn phí: bỏ qua giá riêng lẻ (vẫn giữ giá đã nhập). Giá là cents USD, null/0 = không bán.
  isFree           Boolean                  @default(false) @map("is_free")
  pricePdfCents    Int?                     @map("price_pdf_cents")
  priceMidiCents   Int?                     @map("price_midi_cents")
  priceMp3Cents    Int?                     @map("price_mp3_cents")
  priceBundleCents Int?                     @map("price_bundle_cents")
  status           SheetStatus              @default(DRAFT)
  firstPublishedAt DateTime?                @map("first_published_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cột generated (migration `catalog_search`): chỉ đọc bằng SQL thô trong repository tìm kiếm.
  searchVector     Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  composer  Composer          @relation(fields: [composerId], references: [id], onDelete: Restrict)
  series    Series?           @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  genres    SheetGenre[]
  files     SheetFile[]
  views     SheetViewDedupe[]
  downloads DownloadLog[]
  orders    Order[]

  @@index([status])
  @@index([composerId])
  @@index([seriesId])
  @@index([level])
  @@index([searchVector], type: Gin)
  @@map("sheets")
}

/// Genre của Sheet. Xoá Sheet thì xoá theo (CASCADE); Genre đang được gắn thì không xoá được (RESTRICT).
model SheetGenre {
  sheetId String @map("sheet_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([sheetId, genreId])
  @@index([genreId])
  @@map("sheet_genres")
}

/// Phải trùng enum `FileType` trong packages/shared (có test kiểm tra).
enum FileType {
  PDF
  MIDI
  MP3
  /// Note-JSON dẫn xuất công khai của MIDI (Story 1.7), đối xứng với THUMBNAIL/PAGE_IMAGE của PDF.
  MIDI_JSON
  THUMBNAIL
  PAGE_IMAGE
}

/// File của Sheet. Object nằm trên S3 (module `media`); bảng chỉ lưu key — không bao giờ trả key ra API.
/// Mỗi `(sheet_id, type)` của PDF/MIDI/MP3/MIDI_JSON chỉ có một bản hiện hành (`superseded_at IS NULL`):
/// partial unique index viết tay trong migration. THUMBNAIL/PAGE_IMAGE/MIDI_JSON trỏ tới PDF/MIDI sinh ra
/// chúng qua `source_file_id`.
model SheetFile {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sheetId         String    @map("sheet_id") @db.Uuid
  type            FileType
  storageKey      String    @map("storage_key")
  originalName    String?   @map("original_name")
  /// Bytes.
  size            Int
  mimeType        String    @map("mime_type")
  pageNumber      Int?      @map("page_number")
  /// Chỉ ghi cho dòng MIDI (giây, từ `Midi.duration`); null cho type khác.
  durationSeconds Float?    @map("duration_seconds") @db.DoublePrecision
  /// Chỉ ghi cho dòng MIDI (tổng `track.notes.length` mọi track); null cho type khác.
  noteCount       Int?      @map("note_count")
  sourceFileId    String?   @map("source_file_id") @db.Uuid
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet        Sheet               @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sourceFile   SheetFile?          @relation("SheetFileSource", fields: [sourceFileId], references: [id], onDelete: Cascade)
  derivedFiles SheetFile[]         @relation("SheetFileSource")
  tokenFiles   DownloadTokenFile[]

  @@index([sheetId])
  @@index([sourceFileId])
  @@map("sheet_files")
}

/// Dedupe lượt xem (AD-11, Story 2.7): mỗi `(sheet, visitor_hash, giờ UTC)` được đếm đúng một lần.
/// `visitor_hash` = sha256(ip + ua + VIEW_SALT) hex 64 ký tự; không lưu IP/UA thô. Chỉ ghi bằng SQL thô trong
/// repository `catalog` (cùng câu lệnh tăng `view_count`); job dọn xoá dòng cũ hơn 24 giờ.
model SheetViewDedupe {
  sheetId     String   @map("sheet_id") @db.Uuid
  visitorHash String   @map("visitor_hash") @db.Char(64)
  hourBucket  DateTime @map("hour_bucket") @db.Timestamptz(6)

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@id([sheetId, visitorHash, hourBucket])
  @@index([hourBucket])
  @@map("sheet_view_dedupe")
}

/// Nhật ký mọi lượt tải thành công, miễn phí lẫn trả phí (AD-20, Story 3.2). Chỉ module `commerce` ghi.
/// `ip_hash` = sha256(ip + VIEW_SALT) hex; không lưu IP thô. `token_id` null cho tải miễn phí (token ở Story 3.4).
model DownloadLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sheetId    String   @map("sheet_id") @db.Uuid
  fileType   FileType @map("file_type")
  tokenId    String?  @map("token_id") @db.Uuid
  /// Khách đã đăng nhập thực hiện lượt tải miễn phí (S1 thuê bao); null với lượt tải bằng token mua lẻ.
  customerId String?  @map("customer_id") @db.Uuid
  ipHash     String   @map("ip_hash") @db.Char(64)
  ua         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sheet    Sheet          @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  token    DownloadToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([sheetId, createdAt])
  @@index([customerId])
  @@map("download_logs")
}

/// Phải trùng enum `OrderStatus` trong packages/shared (có test kiểm tra).
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// Đơn hàng (Story 3.3, AD-20). Chỉ module `commerce` ghi; `status` chỉ đổi qua `OrderService` theo máy trạng thái ở shared.
/// `sheet_id` FK RESTRICT: Sheet từng có đơn không bị xoá cứng (archive). `items` là snapshot các type đã resolve kèm giá
/// (`[{fileType, priceCents}]`, bundle được tách từng type). `amount_cents` là cents USD nguyên.
model Order {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Dạng `PD-XXXXXX` (base32).
  orderCode       String      @unique @map("order_code")
  sheetId         String      @map("sheet_id") @db.Uuid
  /// Chữ thường; không bao giờ ghi vào log.
  email           String
  items           Json
  amountCents     Int         @map("amount_cents")
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  paypalOrderId   String?     @unique @map("paypal_order_id")
  paypalCaptureId String?     @map("paypal_capture_id")
  payerEmail      String?     @map("payer_email")
  payerName       String?     @map("payer_name")
  paidAt          DateTime?   @map("paid_at") @db.Timestamptz(6)
  refundedAt      DateTime?   @map("refunded_at") @db.Timestamptz(6)
  reviewRequired  Boolean     @default(false) @map("review_required")
  /// `vi` | `en` (CHECK ở migration): ngôn ngữ email link tải (Story 3.7).
  locale          String?     @default("vi")
  emailSentAt     DateTime?   @map("email_sent_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sheet Sheet          @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  token DownloadToken?

  @@index([sheetId])
  @@map("orders")
}

/// Quyền tải của một Order đã PAID (Story 3.4, AD-20): đúng một token cho mỗi Order (`order_id` UNIQUE).
/// Chỉ module `commerce` ghi. `token` là chuỗi ngẫu nhiên mật mã học; không bao giờ ghi vào log.
model DownloadToken {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String    @unique @map("order_id") @db.Uuid
  token         String    @unique
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  maxDownloads  Int       @map("max_downloads")
  usedDownloads Int       @default(0) @map("used_downloads")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  files        DownloadTokenFile[]
  downloadLogs DownloadLog[]

  @@map("download_tokens")
}

/// Danh sách `sheet_files` hiện hành tại lúc cấp token. FK RESTRICT: GC không xoá file còn được token tham chiếu.
model DownloadTokenFile {
  tokenId     String @map("token_id") @db.Uuid
  sheetFileId String @map("sheet_file_id") @db.Uuid

  token DownloadToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  file  SheetFile     @relation(fields: [sheetFileId], references: [id], onDelete: Restrict)

  @@id([tokenId, sheetFileId])
  @@index([sheetFileId])
  @@map("download_token_files")
}

/// Cấu hình key-value của site (Story 3.3). Chỉ module `settings` đọc/ghi. Khoá seed trong migration:
/// `payments_enabled`, `token_default_days`, `token_default_max_downloads`.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

/// Sự kiện webhook PayPal đã xác thực chữ ký (Story 3.8). `provider_event_id` UNIQUE chặn xử lý trùng.
/// Chỉ module `commerce` ghi. `processed_at` null = chưa xử lý xong (PayPal gửi lại sẽ xử lý lại). Không log payload.
model PaymentEvent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerEventId String    @unique @map("provider_event_id")
  type            String
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payment_events")
}

/// Phải trùng enum `AdPosition` trong packages/shared (có test kiểm tra).
enum AdPosition {
  HEADER
  SIDEBAR_LEFT
  SIDEBAR_RIGHT
  IN_LIST
  STICKY_BOTTOM
  IN_CONTENT
}

/// Vị trí quảng cáo (Story 4.5). Chỉ module `ads` ghi. `position` UNIQUE: mỗi vị trí tối đa một slot.
/// Nội dung slot: `html_code` HOẶC danh sách `items` (kiểm ở service, không có CHECK liên bảng). `html_code` không bao giờ vào log.
model AdSlot {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  position  AdPosition @unique
  htmlCode  String?    @map("html_code")
  isActive  Boolean    @default(false) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  items AdItem[]

  @@map("ad_slots")
}

/// Nền tảng của sản phẩm quảng cáo; phải trùng const `AdPlatform` trong shared (có test).
enum AdPlatform {
  SHOPEE
  TIKTOK
  LAZADA
  OTHER
}

/// Sản phẩm trong một slot (ảnh + link affiliate). Chỉ module `ads` ghi. CHECK (migration): image/link bắt đầu `https://`.
model AdItem {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slotId    String     @map("slot_id") @db.Uuid
  platform  AdPlatform
  image     String
  link      String
  label     String?
  sortOrder Int        @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  slot   AdSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clicks AdClick[]

  @@index([slotId, sortOrder])
  @@map("ad_items")
}

/// Số lượt bấm theo sản phẩm và ngày (UTC). Không lưu IP, UA hay cookie. Chỉ module `ads` ghi.
model AdClick {
  itemId String   @map("item_id") @db.Uuid
  day    DateTime @db.Date
  count  Int      @default(0)

  item AdItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, day])
  @@map("ad_clicks")
}
