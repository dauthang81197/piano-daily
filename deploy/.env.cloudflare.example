# Mẫu cấu hình production sau Cloudflare, đặt tại /opt/piano-daily/.env TRÊN SERVER. KHÔNG commit file .env thật.
# Dùng với: docker compose -f docker-compose.cloudflare.yml. Xem docs/cloudflare.md.

# Domain gốc (không có "https://"). web = ROOT_DOMAIN; admin., api., cdn. là subdomain.
ROOT_DOMAIN=example.com

DOCKERHUB_USERNAME=
IMAGE_TAG=latest

POSTGRES_USER=piano
POSTGRES_PASSWORD=
POSTGRES_DB=piano_daily

# ≥ 32 ký tự, không bắt đầu bằng "change-me". Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Dùng làm X-Internal-Secret (web -> api) và secret revalidate (api -> web). Không có biến secret revalidate riêng.
INTERNAL_API_SECRET=
VIEW_SALT=

# Bắt buộc khi NODE_ENV=production (API không khởi động nếu thiếu).
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RESEND_API_KEY=
EMAIL_FROM=Piano Daily <no-reply@example.com>

# Cloudflare R2 (tạo hai bucket trước; bucket public gắn custom domain cdn.<ROOT_DOMAIN>, bucket private KHÔNG bật public access).
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=piano-daily-public
S3_BUCKET_PRIVATE=piano-daily-private
# Thay example.com bằng ROOT_DOMAIN. Không có "/" cuối.
S3_PUBLIC_BASE_URL=https://cdn.example.com

# CORS (compose tự dựng từ ROOT_DOMAIN, ghi ở đây để đối chiếu):
#   CORS_ADMIN_ORIGIN=https://admin.<ROOT_DOMAIN>
#   CORS_WEB_ORIGIN=https://<ROOT_DOMAIN>
