# Mẫu cấu hình production, đặt tại /opt/piano-daily/.env TRÊN SERVER (deploy/bootstrap-server.sh tạo sẵn bản có secret ngẫu nhiên).
# KHÔNG commit file .env thật.

# Hostname duy nhất của site. Chưa có domain thì dùng sslip.io theo IP, ví dụ 144-91-120-200.sslip.io
SITE_HOST=144-91-120-200.sslip.io

POSTGRES_USER=piano
POSTGRES_PASSWORD=
POSTGRES_DB=piano_daily

# ≥ 32 ký tự, không bắt đầu bằng "change-me". Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
INTERNAL_API_SECRET=
VIEW_SALT=

# Cloudflare R2 (tạo hai bucket trước; bucket public bật truy cập công khai, bucket private thì không).
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=piano-daily-public
S3_BUCKET_PRIVATE=piano-daily-private
# URL công khai của bucket public (r2.dev hoặc custom domain), không có "/" cuối. Phải trùng biến MEDIA_BASE_URL của GitHub.
S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
