# Reverse proxy cho production sau Cloudflare. Domain chỉ đến từ biến ROOT_DOMAIN (vd. example.com):
#   {$ROOT_DOMAIN}        -> web   (cổng nội bộ 4100)
#   admin.{$ROOT_DOMAIN}  -> admin (cổng nội bộ 4101)
#   api.{$ROOT_DOMAIN}    -> api   (cổng nội bộ 4000)
#   cdn.{$ROOT_DOMAIN}    -> KHÔNG qua Caddy: custom domain gắn thẳng vào bucket R2 public trong Cloudflare.
# Cùng site đăng ký nên cookie refresh `SameSite=Strict` giữa admin. và api. hoạt động.
# Cổng 80 phải mở (cho Cloudflare) để Caddy hoàn tất ACME và chuyển hướng http -> https. Cloudflare SSL/TLS mode: Full (strict).
#
# Cloudflare đứng trước: chỉ tin header CF-Connecting-IP khi kết nối đến từ dải IP Cloudflare (trusted_proxies).
# Caddy tính IP khách thật vào {client_ip}; ta chuyển nó cho api/web qua CF-Connecting-IP (AD-18). Dải IP lấy từ
# https://www.cloudflare.com/ips/ — cập nhật cả ở deploy/cloudflare-firewall.sh khi Cloudflare đổi.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:4100 {
		header_up CF-Connecting-IP {client_ip}
	}
}

admin.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:4101
}

api.{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000 {
		header_up CF-Connecting-IP {client_ip}
	}
}
