{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "NODE_ENV",
    "LOG_LEVEL",
    "PORT",
    "JWT_ACCESS_SECRET",
    "REFRESH_TOKEN_TTL_DAYS",
    "NEXT_PUBLIC_API_URL",
    "API_INTERNAL_URL",
    "CORS_ADMIN_ORIGIN"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "prisma/**",
        "prisma.config.ts"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "generate",
        "build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
